#!/bin/sh
# cljsdt's Idris 2 0.8.0 on Chez Scheme 10.4.1, relocatable: everything is
# found next to this file. Chez runs the compiler directly (its #! line names
# the folder it was built in); its binary from its lib folder, as npm keeps
# no symlinks (Chez's bin/ holds only links to it).
set -e
DIR=$(dirname "$(readlink -f -- "$0")")
APP="$DIR/idris/bin/idris2_app"
LIB="$(echo "$DIR"/chez/lib/csv*/*/)"
export SCHEMEHEAPDIRS="$LIB"
export LD_LIBRARY_PATH="$APP:$LD_LIBRARY_PATH"
export IDRIS2_INC_SRC="$APP"
export IDRIS2_PREFIX="$DIR/idris"
export CHEZ="${LIB}scheme"
exec "${LIB}scheme" --program "$APP/idris2.so" "$@"
